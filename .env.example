# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=
# Developer Portal -> OAuth2 -> Client ID
DISCORD_CLIENT_ID=
# 開発用: サーバーIDを入れるとコマンド登録が即時反映
DISCORD_GUILD_ID=

# --- LLM ---
# provider はキーから自動判別。強制する場合: LLM_PROVIDER=openai|anthropic|google
#
# OpenAI互換 (OpenAI / OpenRouter / LM Studio / Ollama / Gemini互換エンドポイント)
# OPENROUTER_API_KEY=            # or OPENAI_API_KEY
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Anthropic ネイティブ (/v1/messages)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
#
# Google ネイティブ (generateContent)
# GEMINI_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# デフォルトモデル (各ユーザーの /model で上書き可)
# LLM_MODEL=openai/gpt-4.1-mini

# DB保存先 (省略時: ./harklet.db)
# HARKLET_DB=

# --- /home ダッシュボードカード ---
# 天気カードの都市名 (Open-Meteo。APIキー不要)
# HOME_CITY=Urawa
# GitHub概要カード (公開リポジトリを集計。省略でカード非表示)
# GITHUB_USER=yourname
# 任意: GitHub APIのレート制限緩和用PAT
# GITHUB_TOKEN=

# --- Computer use (optional) ---
# Encrypts saved login values. Use a random string of 16+ characters and keep it private.
HARKLET_SECRET_KEY=
# Vision-capable model for /computer. Defaults to LLM_MODEL when unset.
# HARKLET_CU_MODEL=
# Local bridge port (the Python sidecar), and the Python to run it with.
# HARKLET_CUA_PORT=7791
# HARKLET_CUA_PYTHON=
